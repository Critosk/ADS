#include <stdio.h>

int main() {
    int n, i;
    float num, min;

    printf("Enter how many numbers: ");
    scanf("%d", &n);

    printf("Enter number 1: ");
    scanf("%f", &min);   // assume first number is minimum

    for (i = 2; i <= n; i++) {
        printf("Enter number %d: ", i);
        scanf("%f", &num);

        if (num < min) {
            min = num;
        }
    }

    printf("The smallest number is: %.2f\n", min);

    return 0;
}
