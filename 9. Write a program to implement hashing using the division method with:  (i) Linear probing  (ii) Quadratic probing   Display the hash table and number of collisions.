#include <stdio.h>

#define SIZE 10   // Hash table size

// Function to initialize hash table
void initialize(int hashTable[]) {
    for (int i = 0; i < SIZE; i++)
        hashTable[i] = -1;
}

// Display hash table
void display(int hashTable[]) {
    printf("\nIndex\tValue\n");
    for (int i = 0; i < SIZE; i++)
        printf("%d\t%d\n", i, hashTable[i]);
}

// Linear Probing Insert
int linearProbing(int hashTable[], int key) {
    int index = key % SIZE;
    int collisions = 0;

    while (hashTable[index] != -1) {
        collisions++;
        index = (index + 1) % SIZE;
    }

    hashTable[index] = key;
    return collisions;
}

// Quadratic Probing Insert
int quadraticProbing(int hashTable[], int key) {
    int index = key % SIZE;
    int i = 1, collisions = 0;
    int newIndex;

    while (1) {
        newIndex = (index + i * i) % SIZE;

        if (hashTable[newIndex] == -1) {
            hashTable[newIndex] = key;
            return collisions;
        }

        collisions++;
        i++;

        if (i == SIZE)  // Table full or probing failed
            return collisions;
    }
}

int main() {
    int n, key;

    // ---------- LINEAR PROBING ----------
    int hashLinear[SIZE];
    initialize(hashLinear);

    printf("Enter number of keys to insert: ");
    scanf("%d", &n);

    int totalLinearCollisions = 0;

    printf("\n--- Linear Probing ---\n");
    for (int i = 0; i < n; i++) {
        printf("Enter key %d: ", i + 1);
        scanf("%d", &key);
        totalLinearCollisions += linearProbing(hashLinear, key);
    }

    printf("\nHash Table (Linear Probing):");
    display(hashLinear);
    printf("\nTotal Collisions (Linear): %d\n", totalLinearCollisions);

    // ---------- QUADRATIC PROBING ----------
    int hashQuadratic[SIZE];
    initialize(hashQuadratic);

    int totalQuadraticCollisions = 0;

    printf("\n--- Quadratic Probing ---\n");
    for (int i = 0; i < n; i++) {
        printf("Enter key %d: ", i + 1);
        scanf("%d", &key);
        totalQuadraticCollisions += quadraticProbing(hashQuadratic, key);
    }

    printf("\nHash Table (Quadratic Probing):");
    display(hashQuadratic);
    printf("\nTotal Collisions (Quadratic): %d\n", totalQuadraticCollisions);

    return 0;
}
