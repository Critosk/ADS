#include <stdio.h>

int main() {
    int count = 0, num = 2, i, isPrime;

    printf("First 50 prime numbers:\n");

    while (count < 50) {
        isPrime = 1;  // assume current number is prime

        // check divisibility
        for (i = 2; i * i <= num; i++) {
            if (num % i == 0) {
                isPrime = 0;
                break;
            }
        }

        if (isPrime) {
            printf("%d ", num);
            count++;
        }

        num++;
    }

    return 0;
}
